[Unit]
Description=Backfill capacity-aware engineering scheduler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Backfill
EnvironmentFile=%h/.config/backfill/backfill.env
ExecStart=%h/Backfill/.venv/bin/backfill serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=mixed

NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target

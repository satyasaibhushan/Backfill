[Unit]
Description=Backfill background work

[Service]
Type=simple
WorkingDirectory=%h/apps/backfill
EnvironmentFile=%h/.config/backfill/backfill.env
ExecStart=%h/apps/backfill/.venv/bin/backfill serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target

BACKFILL_DATA_DIR=~/.local/share/backfill
BACKFILL_PROVIDER_TIMEOUT_SECONDS=45
BACKFILL_PROVIDER_SETTLE_SECONDS=120

# Quota readers run in the service. Guards use the native executors.
BACKFILL_CODEX_COMMAND=/usr/local/bin/codex
BACKFILL_CODEXBAR_COMMAND=/usr/local/bin/codexbar

BACKFILL_CLAUDE_COMMAND=/usr/local/bin/claude
# Optional override; omit to honor CodexBar preferences.
# BACKFILL_CLAUDE_QUOTA_SOURCE=oauth
BACKFILL_METER_ENABLED=true
BACKFILL_METER_INTERVAL_SECONDS=45
BACKFILL_DASHBOARD_PORT=8431

BACKFILL_AUTH_MODE=tailscale
BACKFILL_ALLOWED_LOGIN=satyasaibhushan@github
BACKFILL_PUBLIC_ORIGIN=https://devbox-mark-one.tail6a992e.ts.net

BACKFILL_HOST=127.0.0.1
BACKFILL_PORT=8430
BACKFILL_DATA_DIR=~/.local/share/backfill

# Keep false through the controlled first-dispatch checklist.
BACKFILL_SCHEDULER_ENABLED=false
BACKFILL_SCHEDULER_INTERVAL_SECONDS=60
BACKFILL_PROVIDER_REFRESH_SECONDS=60
BACKFILL_PROVIDER_TIMEOUT_SECONDS=20
BACKFILL_SESSION_RESERVE_PERCENT=20
BACKFILL_WEEKLY_RESERVE_PERCENT=15
BACKFILL_MAX_CONCURRENT_RUNS=1

BACKFILL_ENABLE_CODEX_EXECUTION=true
# Claude's non-interactive allowed-tool policy must be reviewed first.
BACKFILL_ENABLE_CLAUDE_EXECUTION=false
